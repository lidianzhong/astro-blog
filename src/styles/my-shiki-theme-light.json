{
  "name": "custom-highlightjs-light",
  "type": "light",
  "colors": {
    "editor.foreground": "#444444",
    "editor.background": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#697070"
      }
    },
    {
      "scope": "punctuation.definition.comment",
      "settings": {
        "foreground": "#A0A1A7"
      }
    },
    
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#B200B2"
      }
    },
    {
      "scope": "storage.modifier",
      "settings": {
        "foreground": "#B200B2"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#B200B2"
      }
    },
    
    {
      "scope": [
        "markup.deleted",
        "constant.numeric",
        "string.quoted",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "string.template"
      ],
      "settings": {
        "foreground": "#22863A"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#22863A"
      }
    },
    {
      "scope": "meta string.quoted",
      "settings": {
        "foreground": "#22863A"
      }
    },
    
    {
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#005CC5"
      }
    },
    
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#444444"
      }
    },
    {
      "scope": [
        "entity.name.function.member",
        "entity.name.function.method"
      ],
      "settings": {
        "foreground": "#444444"
      }
    },
    {
      "scope": [
        "variable.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#444444"
      }
    },
    {
      "scope": [
        "entity.name.function.java",
        "entity.name.function.cpp",
        "entity.name.function.python"
      ],
      "settings": {
        "foreground": "#005CC5"
      }
    },
    {
      "scope": [
        "entity.name.function.member.cpp",
        "entity.name.function.member.java",
        "support.function.member"
      ],
      "settings": {
        "foreground": "#444444"
      }
    },
    {
      "scope": [
        "support.function.java",
        "entity.name.function.member.java"
      ],
      "settings": {
        "foreground": "#444444"
      }
    },
    
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#444444"
      }
    },
    {
      "scope": [
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#697070"
      }
    },
    
    {
      "scope": [
        "punctuation",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#444444"
      }
    },
    
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#697070"
      }
    },
    
    {
      "scope": "entity.name.section",
      "settings": {
        "fontStyle": "normal"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "keyword.operator",
        "string.regexp",
        "entity.other.attribute-name",
        "entity.other.attribute-name.pseudo-class",
        "constant.other.symbol",
        "variable.interpolation",
        "variable"
      ],
      "settings": {
        "foreground": "#444444"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "support.function",
        "punctuation.definition.list",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#005CC5"
      }
    },
    {
      "scope": "meta",
      "settings": {
        "foreground": "#444444"
      }
    }
  ]
}