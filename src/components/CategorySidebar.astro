---
interface ArticleItem { id: string; title: string; }
interface ArticleGroup { groupLabel: string; articles: ArticleItem[]; }
interface Props { categoryLabel: string; groupArticles?: ArticleGroup[]; noGroupArticles?: ArticleItem[]; }
const { categoryLabel, groupArticles = [], noGroupArticles = [] } = Astro.props as Props;
// 生产环境可能带末尾斜杠，统一去除用于比较
const currentPathRaw = Astro.url.pathname;
const currentPath = currentPathRaw.replace(/\/+$/, '') || '/';
---

<div class="category-sidebar">
  <h1 class="category-sidebar-title">
    <b>{categoryLabel}</b>
  </h1>
  {groupArticles.length > 0 && groupArticles.map((group: ArticleGroup) => {
  const isGroupActive = group.articles.some((article: ArticleItem) => {
      const url = `/blog/${article.id}`.replace(/\/+$/, '');
      return currentPath === url;
    });

    return (
      <details class="group-block" open={isGroupActive} style="border:none;padding:0;">
        <summary class="article-item group-label"
                 style="display:flex;align-items:center;justify-content:flex-start;cursor:pointer; user-select: none;">
          <span class="arrow" style="margin-right:12px;"></span>
          <span style="margin-right:auto;">{group.groupLabel}</span>
        </summary>
        <div class="articles-list">
          {group.articles.map((article: ArticleItem) => {
            const url = `/blog/${article.id}`;
            const normalizedUrl = url.replace(/\/+$/, '');
            const isActive = currentPath === normalizedUrl;
            return (
              <a
                class={`article-item ${isActive ? 'active' : ''}`}
                href={url}
                style="display: flex; align-items: center; text-decoration: none; user-select: none;"
              >
                <div style="margin:0;">{article.title}</div>
              </a>
            );
          })}
        </div>
      </details>
    );
  })}

  {noGroupArticles.length > 0 && noGroupArticles.map((article: ArticleItem) => {
    const url = `/blog/${article.id}`;
    const normalizedUrl = url.replace(/\/+$/, '');
    const isActive = currentPath === normalizedUrl;
    return (
      <a
        class={`article-item ${isActive ? 'active' : ''}`}
        href={url}
        style="display: flex; align-items: center; text-decoration: none;"
      >
        <div style="margin:0;">{article.title}</div>
      </a>
    );
  })}
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const detailsElements = document.querySelectorAll('.category-sidebar details.group-block');
    const categoryLabel = document.querySelector('.category-sidebar-title b')?.textContent;

    if (!categoryLabel) return;

    detailsElements.forEach(d => {
      const details = d as HTMLDetailsElement;
      const groupLabelEl = details.querySelector('summary.group-label > span:first-child');
      if (!groupLabelEl) return;

      const groupLabel = groupLabelEl.textContent;
      const storageKey = `details-state-${categoryLabel}-${groupLabel}`;

      // 暂时禁用箭头动画以避免页面加载时的动画
      const arrow = details.querySelector('.arrow') as HTMLElement;
      if (arrow) {
        arrow.style.transition = 'none';
      }

      // 页面加载时恢复状态
      const savedState = localStorage.getItem(storageKey);
      if (savedState !== null) {
        details.open = savedState === 'true';
      }

      // 使用 requestAnimationFrame 确保状态设置后再重新启用动画
      requestAnimationFrame(() => {
        if (arrow) {
          arrow.style.transition = '';
        }
      });

      // 监听状态变化并保存
      details.addEventListener('toggle', () => {
        localStorage.setItem(storageKey, String(details.open));
      });
    });
  });
</script>