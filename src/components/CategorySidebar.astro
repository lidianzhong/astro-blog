---
import { getCollection } from 'astro:content';

const { category, catrgoryLabel } = Astro.props;
const currentPath = Astro.url.pathname;

const articles = await getCollection('blog', (article) => {
  const articleCategory = article.id.split('/')[0];
  return articleCategory === category;
});

// 从文章内容中提取第一个 # 标题
function extractFirstHeading(content: string) {
  const cleaned = content.replace(/^---[\s\S]*?---\s*/, '');
  const headingMatch = cleaned.match(/^#\s+(.+)$/m);
  return headingMatch ? headingMatch[1] : 'Untitled';
}

// 从 slug 中提取日期
function extractDateFromSlug(slug: string) {
  // 假设 slug 格式为 YYYY-MM-DD-title 或包含日期信息
  const dateMatch = slug.match(/(\d{4}-\d{2}-\d{2})/);
  if (dateMatch) {
    return new Date(dateMatch[1]).toLocaleDateString();
  }
  return '';
}
---

<div class="category-sidebar">
  <h1 class="category-sidebar-title">
    <b>{catrgoryLabel}</b>
  </h1>
  <div class="articles-list">
    {articles.map(article => {
      const [cat, slug] = article.id.split('/');
      const url = `/blog/${cat}/${slug}`;
      const isActive = currentPath === url;
      
      // 获取文章标题和日期
      const title = extractFirstHeading(article.body);
      const date = extractDateFromSlug(slug);
      
      return (
        <a
          class={`article-item ${isActive ? 'active' : ''}`}
          href={url}
          style="cursor: pointer; display: block; text-decoration: none;"
        >
          <h3>{title}</h3>
          {date && <p class="article-date">{date}</p>}
        </a>
      );
    })}
  </div>
</div>