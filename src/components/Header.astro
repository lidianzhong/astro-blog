---
import '../styles/header.css';
import { getCollection } from 'astro:content';

const displayNameMap: Record<string, string> = {
  cpp: 'C++',
  algorithm: '算法',
};

const articles = await getCollection('blog');
const categoriesSet = new Set(
  articles.map(article => article.id.split('/')[0])
);
const categories = Array.from(categoriesSet).map(id => ({
  id,
  displayName: (displayNameMap as Record<string, string>)[id] || id
}));
---

<header id="site-header">
    <nav>
        <div class="nav-container">
            <h1><a href="/">BLOG</a></h1>
            <div class="nav-right">
                <div class="dropdown">
                    <button class="dropbtn">分类</button>
                    <div class="dropdown-content">
                        {categories.map((category) => (
                            <a href={`/blog/${category.id}`}>{category.displayName}</a>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>

