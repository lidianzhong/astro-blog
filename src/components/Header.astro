---
import '../styles/header.css';

// TODO: Replace this with your actual categories data fetching logic
function getCategories() {
    return [
        { id: 'frontend', displayName: '前端' },
        { id: 'backend', displayName: '后端' },
        { id: 'ai', displayName: '人工智能' },
        { id: 'life', displayName: '生活' }
    ];
}

const categories = getCategories();
---

<header>
        <nav>
                <div class="nav-container">
                        <h1><a href="/">我的博客</a></h1>
                        <div class="nav-right">
                                <div class="dropdown">
                                        <button class="dropbtn">分类</button>
                                        <div class="dropdown-content">
                                        {categories.map((category) => (
                                                <a href={`/category/${category.id}`}>{category.displayName}</a>
                                        ))}
                                </div>
                                </div>
                                </div>
                </div>
        </nav>
</header>
