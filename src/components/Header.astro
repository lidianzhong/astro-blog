---
import { getCollection } from 'astro:content';
import CategoryDropdown from './CategoryDropdown.astro';
import ThemeToggle from './ThemeToggle.astro';

import '../styles/header.css';

import categoryToDisplayName from '../content.config';

export interface Props {
  category?: string;
}
const { category } = Astro.props;

const articles = await getCollection('blog');
const categoriesSet = new Set(
  articles.map(article => article.id.split('/')[0])
);
const categories = Array.from(categoriesSet).map(id => ({
  id,
  displayName: (categoryToDisplayName as Record<string, string>)[id] || id
}));

const dropdownLabel = category
  ? ((categoryToDisplayName as Record<string, string>)[category] || category)
  : '分类 ';
---

<header id="site-header">
  <nav>
    <div class="nav-container">
      <h1><a href="/">BLOG</a></h1>
      <div class="nav-right">
        <CategoryDropdown categories={categories} dropdownLabel={dropdownLabel} />
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>