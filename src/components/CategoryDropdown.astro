---
export interface Category {
  id: string;
  displayName: string;
}
export interface Props {
  categories: Category[];
  dropdownLabel: string;
}
const { categories, dropdownLabel } = Astro.props;
---

<div class="categories-dropdown">
  <details id="category-dropdown">
    <summary class="dropdown-btn">{dropdownLabel}</summary>
    <ul class="dropdown-list">
      {categories.map((category) => (
        <li>
          <a href={`/blog/${category.id}`}>{category.displayName}</a>
        </li>
      ))}
    </ul>
  </details>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const details = document.getElementById('category-dropdown') as HTMLDetailsElement;
    
    if (details) {
      const handleClickOutside = (event: MouseEvent) => {
        const target = event.target as Node;
        
        // If clicking outside the details element, close it
        if (!details.contains(target) && details.open) {
          details.open = false;
        }
      };
      
      // Remove previous listener if exists to avoid duplicates
      document.removeEventListener('click', handleClickOutside);
      document.addEventListener('click', handleClickOutside);
    }
  });
</script>

<style>
.categories-dropdown details {
  position: relative;
  display: inline-block;
}
.categories-dropdown summary {
  list-style: none;
  cursor: pointer;
  outline: none;
  color: var(--color-text-secondary);
  font-weight: 500;
}
.categories-dropdown .dropdown-list {
  position: absolute;
  left: 0;
  top: 110%;
  border: 1px solid #ddd;
  min-width: 200px;
  z-index: 10;
  margin: 0;
  padding: 0.3rem 0;
  list-style: none;
  display: none;
  background-color: var(--color-bg-primary);
}
.categories-dropdown .dropdown-list a {
  color: var(--color-text-secondary);
  font-weight: 500;
}
.categories-dropdown details[open] .dropdown-list {
  display: block;
}
</style>