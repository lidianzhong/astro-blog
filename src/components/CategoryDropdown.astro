---
export interface Category {
  id: string;
  displayName: string;
}
export interface Props {
  categories: Category[];
  dropdownLabel: string;
}
const { categories, dropdownLabel } = Astro.props;
---

<div class="categories-dropdown">
  <details>
    <summary class="dropdown-btn">{dropdownLabel}</summary>
    <ul class="dropdown-list">
      {categories.map((category) => (
        <li>
          <a href={`/blog/${category.id}`}>{category.displayName}</a>
        </li>
      ))}
    </ul>
  </details>
</div>

<style>
.categories-dropdown details {
  position: relative;
  display: inline-block;
}
.categories-dropdown summary {
  list-style: none;
  cursor: pointer;
  outline: none;
}
.categories-dropdown .dropdown-list {
  position: absolute;
  left: 0;
  top: 110%;
  border: 1px solid #ddd;
  min-width: 200px;
  z-index: 10;
  margin: 0;
  padding: 0.3rem 0;
  list-style: none;
  display: none;
}
.categories-dropdown details[open] .dropdown-list {
  display: block;
}
</style>