---
import { getCollection } from 'astro:content';

import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import CategorySidebarLayout from '../../../layouts/CategorySidebarLayout.astro';
import MainLayout from '../../../layouts/MainLayout.astro';

import '../../../styles/category-page.css';

const { category, slug } = Astro.params;

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  return articles.map(article => {
    const [category, slug] = article.id.split('/');
    return { params: { category, slug } };
  });
}
---

<MainLayout>
  <CategorySidebarLayout category={category} />
  <ArticleLayout id={`${category}/${slug}`} />
</MainLayout>