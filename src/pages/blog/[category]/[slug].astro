---
import { getCollection } from 'astro:content';

import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import CategorySidebarLayout from '../../../layouts/CategorySidebarLayout.astro';
import MainLayout from '../../../layouts/MainLayout.astro';

const { category, slug } = Astro.params;

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  return articles.map(article => {
    const [category, slug] = article.id.split('/');
    return { params: { category, slug } };
  });
}
---

<MainLayout>
  <CategorySidebarLayout category={category} transition:persist/> <!-- TODO: transition need to be fixed -->
  <ArticleLayout id={`${category}/${slug}`} isEdit={false} transition:animate="none"/> <!-- TODO: transition need to be fixed -->
</MainLayout>