---
import { ClientRouter } from "astro:transitions"; 

import '../styles/global.css';

const { title = "Dawn Journey" } = Astro.props;
const pageTitle = title === "Dawn Journey" ? title : `${title} - Dawn Journey`;
---

<!-- transition:animate="none" -->
<!-- transition:persist-props -->

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <ClientRouter />
        <script is:inline>
            // 立即执行的主题初始化脚本，避免闪烁
            (function() {
                function initTheme() {
                    const savedTheme = localStorage.getItem('theme');
                    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                    
                    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                        document.documentElement.classList.add('dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                    }
                }

                // 立即初始化
                initTheme();
                
                // 监听系统主题变化
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
                    if (!localStorage.getItem('theme')) {
                        document.documentElement.classList.toggle('dark', e.matches);
                    }
                });
                
                // 当导航完成后重新初始化主题
                document.addEventListener('astro:page-load', initTheme);
                document.addEventListener('astro:after-swap', initTheme);
            })();
        </script>
        <script is:inline>
            (function() {
                const VRITE_TOKEN = "FHnI--Ivk2TIyhs_7eMWD:laAE0JFodUdy9q0BM0Yf6";

                function isEditable(el) {
                    if (!el) return false;
                    const tag = el.tagName;
                    return (
                        el.isContentEditable ||
                        tag === 'INPUT' ||
                        tag === 'TEXTAREA' ||
                        tag === 'SELECT'
                    );
                }

                function getSlugMdFromPath() {
                    try {
                        let path = window.location.pathname || '/';
                        path = path.replace(/\/+$/, '');
                        if (path === '' || path === '/') return null;

                        const segments = path.split('/').filter(Boolean);
                        const last = segments.pop();
                        if (!last) return null;

                        // 去掉可能的 .html 或结尾的 -md 避免重复
                        let base = decodeURIComponent(last)
                            .replace(/\.html?$/i, '')
                            .replace(/-md$/i, '');

                        // 规范化：把下划线转换为短横线，避免不同命名风格导致 slug 不一致
                        // 例如 2024-04-19-how_to_switch_cuda_versions -> 2024-04-19-how-to-switch-cuda-versions
                        base = base.replace(/_/g, '-').replace(/--+/g, '-');

                        if (!base) return null;
                        return base + '-md';
                    } catch {
                        return null;
                    }
                }

                async function queryVriteIdBySlug(slugMd) {
                    const url = new URL('https://api.vrite.io/content-pieces/list');
                    url.searchParams.set('slug', slugMd);
                    const res = await fetch(url.toString(), {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json',
                            'Authorization': 'Bearer ' + VRITE_TOKEN
                        }
                    });
                    if (!res.ok) return null;
                    const data = await res.json();
                    if (!Array.isArray(data) || data.length === 0) return null;
                    const match = data.find(x => x && x.slug === slugMd) || data[0];
                    return match && match.id ? match.id : null;
                }

                async function onKeyDown(e) {
                    if (isEditable(document.activeElement)) return;
                    if (e.key !== '/' || e.altKey || e.ctrlKey || e.metaKey) return;
                    e.preventDefault();
                    const slugMd = getSlugMdFromPath();
                    if (!slugMd) return;
                    try {
                        const id = await queryVriteIdBySlug(slugMd);
                        if (id) {
                            window.location.href = 'https://app.vrite.io/editor/' + id;
                        }
                    } catch {}
                }

                window.addEventListener('keydown', onKeyDown, { passive: false });
            })();
        </script>
        
    </head>
    <body transition:animate="none">
        <slot name="header"/>
        <main>
            <div class="site-container">
                <slot />
            </div>
        </main>
    </body>
</html>
