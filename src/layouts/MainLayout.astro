---
import { ClientRouter } from "astro:transitions"; 

import '../styles/global.css';

const { title = "Dawn Journey" } = Astro.props;
const pageTitle = title === "Dawn Journey" ? title : `${title} - Dawn Journey`;
// Prefer a PUBLIC_ env var; fallback to provided token to keep working without config
const VRITE_TOKEN = import.meta.env.PUBLIC_VRITE_TOKEN ?? "FHnI--Ivk2TIyhs_7eMWD:laAE0JFodUdy9q0BM0Yf6";
---

<!-- transition:animate="none" -->
<!-- transition:persist-props -->

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <ClientRouter />
        <script is:inline>
            // 立即执行的主题初始化脚本，避免闪烁
            (function() {
                function initTheme() {
                    const savedTheme = localStorage.getItem('theme');
                    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                    
                    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                        document.documentElement.classList.add('dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                    }
                }

                // 立即初始化
                initTheme();
                
                // 监听系统主题变化
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
                    if (!localStorage.getItem('theme')) {
                        document.documentElement.classList.toggle('dark', e.matches);
                    }
                });
                
                // 当导航完成后重新初始化主题
                document.addEventListener('astro:page-load', initTheme);
                document.addEventListener('astro:after-swap', initTheme);
            })();
        </script>
        <script is:inline set:html={`
            // 按 '/' 快捷键：根据当前页面 slug 查询 Vrite 内容并跳转到编辑器
            (function() {
                const VRITE_TOKEN = ${JSON.stringify(VRITE_TOKEN)};

                function isEditable(el) {
                    if (!el) return false;
                    const tag = el.tagName;
                    return (
                        el.isContentEditable ||
                        tag === 'INPUT' ||
                        tag === 'TEXTAREA' ||
                        tag === 'SELECT'
                    );
                }

                function getSlugMdFromPath() {
                    try {
                        // 去掉结尾的斜杠，取最后一个路径段
                        const path = window.location.pathname.replace(/\/+$/, '');
                        const segments = path.split('/').filter(Boolean);
                        const last = segments[segments.length - 1] || '';
                        if (!last) return null;
                        const base = decodeURIComponent(last);
                        return base + '-md';
                    } catch (_) {
                        return null;
                    }
                }

                async function queryVriteIdBySlug(slugMd) {
                    const url = new URL('https://api.vrite.io/content-pieces/list');
                    url.searchParams.set('slug', slugMd);
                    const res = await fetch(url.toString(), {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json',
                            'Authorization': 'Bearer ' + VRITE_TOKEN
                        },
                        mode: 'cors',
                        credentials: 'omit'
                    });
                    if (!res.ok) return null;
                    const data = await res.json();
                    if (!Array.isArray(data) || data.length === 0) return null;
                    const match = data.find(function(x){ return x && x.slug === slugMd; }) || data[0];
                    return match && match.id ? match.id : null;
                }

                async function onKeyDown(e) {
                    // 仅在未聚焦可编辑元素时响应
                    if (isEditable(document.activeElement)) return;
                    if (e.key !== '/' || e.altKey || e.ctrlKey || e.metaKey) return;
                    e.preventDefault();
                    const slugMd = getSlugMdFromPath();
                    if (!slugMd) return;
                    try {
                        const id = await queryVriteIdBySlug(slugMd);
                        if (id) {
                            window.location.href = 'https://app.vrite.io/editor/' + id;
                        }
                    } catch (_) {
                        // 静默失败
                    }
                }

                window.addEventListener('keydown', onKeyDown, { passive: false });
            })();
        `} />
        
    </head>
    <body transition:animate="none">
        <slot name="header"/>
        <main>
            <div class="site-container">
                <slot />
            </div>
        </main>
    </body>
</html>
