---
import { getEntry, render } from 'astro:content';

import '../styles/markdown.css'

const { id } = Astro.props;

const entry = await getEntry('blog', id);
if (!entry) {
  throw new Error(`Article with id "${id}" not found.`);
}
if (!entry.body) {
  throw new Error(`Article with id "${id}" has no content.`);
}

const { Content } = await render(entry);


function getTitleByMarkdown(markdown: string): string | null {
  const match = markdown.match(/^#\s+(.*)/m);
  return match ? match[1] : null;
}

function getDateFromArticleId(id: string): string {
  // id format: 'cpp/2025-07-08-second-article'
  const match = id.match(/(\d{4})-(\d{2})-(\d{2})/);
  if (!match) return "";
  const [, year, month, day] = match;
  // return format: '2025年7月8日'
  return `${year}年${parseInt(month, 10)}月${parseInt(day, 10)}日`;
}

const articleTitle = getTitleByMarkdown(entry.body);
const articleDate = getDateFromArticleId(id); // 文章日期从 ID 中拿到
---

<article id="site-content" class="md:ml-[calc(var(--side-bar-width))]">
  <div class="site-content-container">
    <div class="article-header">
      <h1 class="article-title">{articleTitle}</h1>
      <p class="article-date">{articleDate}</p>
    </div>
    <div class="article-content prose">
      <Content />
    </div>
  </div>
</article>

<style>
  .site-content-container {
    max-width: calc(100vw - var(--side-bar-width) - 4rem);
    margin: 0 auto;
    padding: 2rem 3rem;
    font-family: "NunitoVariable", sans-serif;
  }

  @media (max-width: 768px) {
    .site-content-container {
      max-width: 100%;
      padding: 2rem 1rem;
    }
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-title {
    font-family: "NunitoVariable", sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.25rem;
    color: var(--color-text-primary);
  }

  .article-date {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .article-content {
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--color-text-primary);
    max-width: 72ch !important;
  }

  /* 覆盖 prose 的默认最大宽度限制 */
  .article-content :global(.prose) {
    max-width: 72ch !important;
  }

  .article-content :global(h1:first-child) {
    display: none; /* 隐藏 Content 中的 h1 标题 */
  }
</style>